{
  "name": "wishful-ai-draw",
  "version": "0.2.1",
  "description": "Batch AI Image Generation Desktop App powered by Electron and fal.ai",
  "main": "./out/main/index.js",
  "author": "Wishful AI",
  "homepage": "https://fal.ai",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "ELECTRON_RUN_AS_NODE= electron-vite preview",
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "sync:fal-models": "node scripts/sync-fal-models.mjs",
    "sync:fal-text-to-image": "node scripts/sync-fal-text-to-image.mjs",
    "sync:fal-text-to-video": "node scripts/sync-fal-text-to-video.mjs",
    "sync:fal-image-to-video": "node scripts/sync-fal-image-to-video.mjs",
    "sync:fal": "npm run sync:fal-models && npm run sync:fal-text-to-image && npm run sync:fal-text-to-video && npm run sync:fal-image-to-video",
    "test": "vitest run"
  },
  "dependencies": {
    "@fal-ai/client": "^1.2.3",
    "@xyflow/react": "^12.12.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.469.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
